# Copiar a .env y completar. Todo lo EXPO_PUBLIC_* termina en el bundle: nunca poner secretos acá.

# Supabase local: `npx supabase status` en la raíz (API URL y anon key)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API Hono (local: pnpm dev:api) o la URL de Vercel
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Mapbox: token público (pk.…)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google Sign-In (Google Cloud → OAuth clients). El iOS URL scheme se deriva del client id de iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
