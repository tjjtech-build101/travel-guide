# Supabase (local: `npx supabase status` en la raíz del repo)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: solo si tu Supabase firma los JWT con HS256 (local viejo). Si falta, se usa JWKS y después auth.getUser.
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Places API (New) + Routes API. Si falta: search_places/place_details -> not_configured; route_eta estima por distancia.
GOOGLE_MAPS_API_KEY=

# Puerto local (src/dev.ts)
PORT=8787

# Planificador plan_trip (PRD 01). Defaults: effort high, web search true, 16000 max_tokens, 150 s por tramo.
PLANNER_EFFORT=high
PLANNER_WEB_SEARCH=true
PLANNER_MAX_TOKENS=16000
# PLANNER_LEG_TIMEOUT_S=150
# PLANNER_MAX_ITERATIONS=40
# PLANNER_FALLBACKS=true
